:zeus a dbo:Deity ;
    rdfs:label "Zeus"@en ;
    owl:sameAs <https://www.wikidata.org/wiki/Q34201> .

:zeus_hera_dispute a crm:E5_Event ;
    rdfs:label "Dispute between Zeus and Hera judged by Tiresias"@en ;
    crm:P11_had_participant :hera,
        :tiresias,
        :zeus ;
    :isPreconditionedBy :sex_change ;
    :resultsIn :prophecy .

:hera a dbo:Deity ;
    rdfs:label "Hera"@en ;
    owl:sameAs <http://www.wikidata.org/entity/Q38012> ;
    schema:spouse :zeus .

:prophecy a skos:Concept ;
    rdfs:label "Prophecy"@en ;
    owl:sameAs <https://www.wikidata.org/wiki/Q214267> .

:sex_change a crm:E7_Activity ;
    rdfs:label "Transformation of Tiresias into a woman"@en ;
    crm:P11_had_participant :tiresias ;
    crm:P120_occurs_before :zeus_hera_dispute ;
    crm:P14_carried_out_by :hera ;
    crm:P7_took_place_at :mount_cyllene .

:tiresias a dbo:MythologicalFigure ;
    rdfs:label "Tiresias"@en,
