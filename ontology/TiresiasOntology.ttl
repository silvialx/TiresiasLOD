@prefix : <https://tiresias-lod.github.io/TiresiasLOD/ontology/TiresiasOntology#> .
@prefix tir: <https://tiresias-lod.github.io/TiresiasLOD/ontology/TiresiasOntology#> .

@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://tiresias-lod.github.io/TiresiasLOD/ontology/TiresiasOntology#> .


#################################################################
#    Ontology
#################################################################

<https://tiresias-lod.github.io/TiresiasLOD/ontology/TiresiasOntology#>
    rdf:type owl:Ontology ;
    rdfs:label "TiresiasOntology"@en ;
    rdfs:comment "This ontology was created for an individual Information Science and Cultural Heritage project and models how the mythological figure of Tiresias connects places, events, deities, literary works and visual artworks across Antiquity, early modern art and modernist poetry."@en .


#################################################################
#    Object Properties
#################################################################

### CIDOC CRM

crm:P7_took_place_at
    rdf:type owl:ObjectProperty ;
    rdfs:domain crm:E5_Event ;
    rdfs:range dbo:Mountain ;
    rdfs:isDefinedBy crm: .

crm:P11_had_participant
    rdf:type owl:ObjectProperty ;
    rdfs:domain crm:E5_Event ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( dbo:MythologicalFigure dbo:Deity ) ] ;
    rdfs:isDefinedBy crm: .

crm:P14_carried_out_by
    rdf:type owl:ObjectProperty ;
    rdfs:domain crm:E7_Activity ;
    rdfs:range dbo:Deity ;
    rdfs:isDefinedBy crm: .

crm:P62_depicts
    rdf:type owl:ObjectProperty ;
    rdfs:domain schema:VisualArtwork ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( crm:E5_Event dbo:MythologicalFigure dbo:Deity ) ] ;
    rdfs:isDefinedBy crm: .

crm:P120_occurs_before
    rdf:type owl:ObjectProperty ;
    owl:inverseOf crm:P120i_occurs_after ;
    rdfs:domain crm:E5_Event ;
    rdfs:range crm:E5_Event ;
    rdfs:isDefinedBy crm: .

crm:P120i_occurs_after
    rdf:type owl:ObjectProperty ;
    rdfs:domain crm:E5_Event ;
    rdfs:range crm:E5_Event ;
    rdfs:isDefinedBy crm: .

crm:P129_is_about
    rdf:type owl:ObjectProperty ;
    rdfs:domain dbo:WrittenWork ;
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf ( crm:E5_Event skos:Concept ) ] ;
    rdfs:isDefinedBy crm: .


### Dublin Core Terms

dcterms:creator
    rdf:type owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:Person ;
    rdfs:isDefinedBy dcterms: .


### Schema.org

schema:character
    rdf:type owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range dbo:FictionalCharacter ;
    rdfs:isDefinedBy schema: .

schema:containedInPlace
    rdf:type owl:ObjectProperty ;
    rdfs:domain schema:Place ;
    rdfs:range schema:Place ;
    rdfs:isDefinedBy schema: .

schema:contentLocation
    rdf:type owl:ObjectProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range schema:Place ;
    rdfs:isDefinedBy schema: .

schema:spouse
    rdf:type owl:ObjectProperty ;
    rdf:type owl:SymmetricProperty ;
    rdfs:domain dbo:Deity ;
    rdfs:range dbo:Deity ;
    rdfs:isDefinedBy schema: .

schema:workLocation
    rdf:type owl:ObjectProperty ;
    rdfs:domain dbo:MythologicalFigure ;
    rdfs:range schema:Place ;
    rdfs:isDefinedBy schema: .


### Europeana Data Model

edm:isRelatedTo
    rdf:type owl:ObjectProperty ;
    rdfs:isDefinedBy edm: .


#################################################################
#    Local Object Properties
#################################################################

tir:hasGift
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf edm:isRelatedTo ;
    rdfs:domain dbo:MythologicalFigure ;
    rdfs:range skos:Concept ;
    rdfs:label "has gift"@en ;
    rdfs:comment "Relates a mythological figure to a supernatural ability or faculty bestowed upon it, such as foresight or prophecy."@en ;
    rdfs:isDefinedBy tir: .


tir:isPreconditionedBy
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P120i_occurs_after ;
    rdfs:domain crm:E5_Event ;
    rdfs:range crm:E5_Event ;
    rdfs:label "is preconditioned by"@en ;
    rdfs:comment "Relates an event to an earlier event without which it could not have taken place. Since a precondition necessarily precedes what it makes possible, the property is a specialisation of CIDOC CRM 'occurs after'."@en ;
    rdfs:isDefinedBy tir: .


tir:resultsIn
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf edm:isRelatedTo ;
    rdfs:domain crm:E5_Event ;
    rdfs:range skos:Concept ;
    rdfs:label "results in"@en ;
    rdfs:comment "Relates an event to a concept (a condition, faculty or state) that comes into being as its outcome."@en ;
    rdfs:isDefinedBy tir: .


tir:prophesiedAbout
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf edm:isRelatedTo ;
    rdfs:domain dbo:MythologicalFigure ;
    rdfs:range dbo:MythologicalFigure ;
    rdfs:label "prophesied about"@en ;
    rdfs:comment "Relates a seer to a mythological figure whose fate was the subject of one of the seer's prophecies."@en ;
    rdfs:isDefinedBy tir: .


tir:illustrates
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf edm:isRelatedTo ;
    rdfs:domain schema:VisualArtwork ;
    rdfs:range schema:CreativeWork ;
    rdfs:label "illustrates"@en ;
    rdfs:comment "Relates a visual artwork to a textual work it was produced to accompany or illustrate, e.g. an engraving published in an edition of that work."@en ;
    rdfs:isDefinedBy tir: .


#################################################################
#    Datatype Properties
#################################################################

### Dublin Core Terms

dcterms:created
    rdf:type owl:DatatypeProperty ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range xsd:gYear ;
    rdfs:comment "Used for the composition, publication and creation dates encoded in the TEI (Metamorphoses, The Waste Land, the Kraus engraving)."@en ;
    rdfs:isDefinedBy dcterms: .


#################################################################
#    Classes
#################################################################

### Schema.org

schema:CreativeWork
    rdf:type owl:Class ;
    rdfs:isDefinedBy schema: .

schema:VisualArtwork
    rdf:type owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:isDefinedBy schema: .

schema:Person
    rdf:type owl:Class ;
    rdfs:isDefinedBy schema: .

schema:Place
    rdf:type owl:Class ;
    rdfs:isDefinedBy schema: .


### DBpedia

dbo:FictionalCharacter
    rdf:type owl:Class ;
    rdfs:isDefinedBy dbo: .

dbo:MythologicalFigure
    rdf:type owl:Class ;
    rdfs:subClassOf dbo:FictionalCharacter ;
    rdfs:isDefinedBy dbo: .

dbo:Deity
    rdf:type owl:Class ;
    rdfs:isDefinedBy dbo: .

dbo:Mountain
    rdf:type owl:Class ;
    rdfs:subClassOf schema:Place ;
    rdfs:isDefinedBy dbo: .

dbo:WrittenWork
    rdf:type owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:isDefinedBy dbo: .

dbo:Play
    rdf:type owl:Class ;
    rdfs:subClassOf dbo:WrittenWork ;
    rdfs:isDefinedBy dbo: .


### CIDOC CRM

crm:E5_Event
    rdf:type owl:Class ;
    rdfs:isDefinedBy crm: .


### SKOS

skos:Concept
    rdf:type owl:Class ;
    rdfs:isDefinedBy skos: .


#################################################################
#    Datatypes
#################################################################

xsd:gYear
    rdf:type rdfs:Datatype .
